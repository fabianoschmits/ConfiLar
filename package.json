{
  "name": "confilar-v3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "dev:3000": "next dev -p 3000",
    "dev:force": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "docs:api": "typedoc",
    "docs:serve": "npx http-server docs/api -p 3002",
    "analyze": "ANALYZE=true npm run build",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "backup:create": "node scripts/backup.js",
    "backup:list": "node scripts/list-backups.js",
    "env:validate": "node scripts/validate-env.js",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/clean-cache.ps1",
    "clean:hard": "powershell -ExecutionPolicy Bypass -File scripts/clean-cache.ps1 && npm install",
    "prepare": "husky"
  },
