  "product_overview": "ConfiLar is a professional trust platform connecting qualified professionals with clients through a comprehensive ecosystem based on ratings, recommendations, real-time social interactions, and an internal economy using points (ConfiPoints).",
  "core_goals": [
    "Facilitate connections between professionals and clients",
    "Establish trust through a robust system of reviews and recommendations",
    "Implement an internal economy with a points system (ConfiPoints)",
    "Provide a rich social experience with real-time feed and chat interactions",
    "Ensure full compliance with LGPD and data security standards"
  ],
  "key_features": [
    "Comprehensive authentication system with email verification, password recovery, OTP reauthentication, and account security",
    "Detailed user profiles featuring personal and professional info, smart avatars, badge systems, favorites, and activity history",
    "Real-time social feed with automatic posts, likes, comments, shares, trending calculations, and mentions",
    "Integrated floating chat system with real-time messaging, read status, notifications, and scheduling",
    "ConfiPoints internal economy with earning, spending, dashboard, rankings, levels, and referral system",
    "Advanced multi-filter search by location, service, price, rating, and text, including proximity search",
    "Robust review and recommendation system with star ratings, automatic posts, and history",
    "Intelligent notification system supporting real-time updates, custom sounds, push notifications, granular settings, and silent mode",
    "Progressive Web App with offline capabilities, installability, service workers, push notifications, and smart caching",
    "Admin dashboard for user management, bans, reports, analytics, logs, and points oversight",
    "Complete LGPD compliance covering privacy policies, consent, data portability, deletion, and export"
  ],
  "user_flow_summary": [
    "User registration requiring email verification and onboarding leading to feed access",
    "Clients searching professionals applying filters, viewing profiles, and initiating contacts or favorites",
    "Clients reviewing services post-completion, generating automatic posts and professional notifications",
    "Users earning points for activities with daily caps and referral bonus, updated with notifications and dashboard changes"
  ],
  "validation_criteria": [
    "Users can register and verify unique emails with prevention of duplicate accounts",
    "Secure login with rate limiting and password recovery support",
    "Profiles editable with automatic avatar generation and badge updates",
    "Real-time feed operational with likes, comments, shares, trending, and notifications",
    "Floating chat available on all pages with real-time messaging and read status",
    "Points system accurately credits and debits points with transaction history and balance validation",
    "Advanced search returns filtered and relevant results including proximity order",
    "Review system permits posting and displaying ratings, automatic posts, and notifications",
    "Notifications send real-time updates with customizable sounds and silent mode",
    "PWA features functional with offline and installable app capabilities",
    "Admins can manage users, bans, reports and view analytics effectively",
    "LGPD compliance features fully implemented including user data export and deletion"
  ],
