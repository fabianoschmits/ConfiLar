
<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="gradient-maskable" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1f2937;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#000000;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Full background for maskable -->
  <rect width="512" height="512" fill="url(#gradient-maskable)" rx="102.4"/>
  
  <!-- Letter C centered -->
  <text x="256" y="298.6666666666667" 
        font-family="Arial, sans-serif" 
        font-size="256" 
        font-weight="bold" 
        text-anchor="middle" 
        fill="#ffffff">C</text>
