
<svg width="144" height="144" viewBox="0 0 144 144" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1f2937;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#000000;stop-opacity:1" />
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000000" flood-opacity="0.3"/>
    </filter>
  </defs>
  
  <!-- Background circle -->
  <circle cx="72" cy="72" r="70" fill="url(#gradient)" filter="url(#shadow)"/>
  
  <!-- Inner circle for depth -->
  <circle cx="72" cy="72" r="64" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.2"/>
  
  <!-- Letter C -->
  <text x="72" y="84" 
        font-family="Arial, sans-serif" 
        font-size="86.39999999999999" 
        font-weight="bold" 
        text-anchor="middle" 
        fill="#ffffff"
        filter="url(#shadow)">C</text>
  
  <!-- Small accent dot -->
  <circle cx="108" cy="36" r="4.32" fill="#ffffff" opacity="0.8"/>
</svg>