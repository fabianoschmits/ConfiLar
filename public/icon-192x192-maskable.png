
<svg width="192" height="192" viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="gradient-maskable" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1f2937;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#000000;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Full background for maskable -->
  <rect width="192" height="192" fill="url(#gradient-maskable)" rx="38.400000000000006"/>
  
  <!-- Letter C centered -->
  <text x="96" y="112" 
        font-family="Arial, sans-serif" 
        font-size="96" 
        font-weight="bold" 
        text-anchor="middle" 
        fill="#ffffff">C</text>
</svg>