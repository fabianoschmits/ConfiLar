# ===================================
# SUPABASE CONFIGURATION
# ===================================

# URL principal do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Chave pública (anon key) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Chave de serviço (service role) - APENAS SERVIDOR
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===================================
# AUTHENTICATION
# ===================================

# Secret para JWT (NextAuth ou custom)
NEXTAUTH_SECRET=your_nextauth_secret

# URL base da aplicação
NEXTAUTH_URL=http://localhost:3000

# ===================================
# APPLICATION SETTINGS
# ===================================

# Ambiente da aplicação
NEXT_PUBLIC_APP_ENV=development

# Versão da aplicação
NEXT_PUBLIC_APP_VERSION=5.0.0

# Nome da aplicação
NEXT_PUBLIC_APP_NAME=ConfiLar

# URL base da API
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ===================================
# FEATURE FLAGS
# ===================================

# Habilitar modo de debug
NEXT_PUBLIC_DEBUG_MODE=true

# Habilitar DevTools do React Query
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=true

# Habilitar logging detalhado
NEXT_PUBLIC_ENABLE_DETAILED_LOGGING=true

# Habilitar análise de performance
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# Habilitar backup automático
ENABLE_AUTOMATIC_BACKUP=false

# ===================================
# EXTERNAL SERVICES
# ===================================

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Discord Webhook para notificações
DISCORD_WEBHOOK_URL=your_discord_webhook

# ===================================
# EMAIL CONFIGURATION (Se usar)
# ===================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# SendGrid (alternativa)
SENDGRID_API_KEY=your_sendgrid_api_key

# ===================================
# FILE UPLOAD & STORAGE
# ===================================

# Tamanho máximo de upload (em bytes)
NEXT_PUBLIC_MAX_FILE_SIZE=5242880

# Tipos de arquivo permitidos
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ===================================
# RATE LIMITING
# ===================================

# Limite de requests por minuto por IP
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Limite de requests para APIs sensíveis
RATE_LIMIT_SENSITIVE_REQUESTS_PER_MINUTE=10

# ===================================
# CACHE CONFIGURATION
# ===================================

# TTL para cache estático (em segundos)
CACHE_TTL_STATIC=86400

# TTL para cache dinâmico (em segundos)
CACHE_TTL_DYNAMIC=300

# ===================================
# DATABASE BACKUP
# ===================================

# Retenção de backups em dias
BACKUP_RETENTION_DAYS=30

# Backup automático habilitado
BACKUP_AUTOMATIC_ENABLED=false

# Horário do backup automático (cron format)
BACKUP_SCHEDULE=0 2 * * *

# ===================================
# SECURITY
# ===================================

# Chave para criptografia de dados sensíveis
ENCRYPTION_KEY=your_32_character_encryption_key

# Salt para hashing
HASH_SALT=your_hash_salt

# CORS Origins permitidas
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ===================================
# DEVELOPMENT ONLY
# ===================================

# Habilitar seeds de desenvolvimento
DEV_ENABLE_SEEDS=true

# Pular verificações de e-mail em dev
DEV_SKIP_EMAIL_VERIFICATION=true

# Mock de serviços externos
DEV_MOCK_EXTERNAL_SERVICES=true

# ===================================
# MONITORING & OBSERVABILITY
# ===================================

# Habilitar métricas de performance
ENABLE_PERFORMANCE_METRICS=true

# Habilitar logs estruturados
ENABLE_STRUCTURED_LOGGING=true

# Nível de log (debug, info, warn, error)
LOG_LEVEL=debug

# ===================================
# API KEYS (Third Party)
# ===================================

# IBGE API (geralmente não precisa de key)
IBGE_API_URL=https://servicodados.ibge.gov.br/api/v1

# Outros serviços que você possa usar
# MAPS_API_KEY=your_maps_api_key
# PAYMENT_API_KEY=your_payment_api_key

